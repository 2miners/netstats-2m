# Copy to <name>.env next to the binary, then: systemctl enable --now netstats-2m@<name>
# Node WebSocket RPC (geth/core-geth: --ws --ws.port 8546 --ws.origins '*' --ws.api admin,eth,net,web3,txpool).
# WS_HOST/WS_PORT and RPC_HOST/RPC_PORT are the same setting, WS_* wins; keep both equal.
WS_HOST=localhost
WS_PORT=8546
RPC_HOST=localhost
RPC_PORT=8546
WS_SERVER=wss://ethw-stats.2miners.com
WS_SECRET=4ce279da264302069d919845eead5350
INSTANCE_NAME=Your Pool Ethereum PoW
CONTACT_DETAILS=
LISTENING_PORT=30303
NODE_ENV=production
VERBOSITY=1
