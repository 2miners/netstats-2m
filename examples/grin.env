# Grin: copy to /opt/netstats-2m/<name>.env, then: systemctl enable --now netstats-2m@<name>
# Grin node API v2: RPC_PASSWORD = .foreign_api_secret (if set), RPC_OWNER_PASSWORD = .api_secret (peers, sync state)
