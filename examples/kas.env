# Kaspa: copy to /opt/netstats-2m/<name>.env, then: systemctl enable --now netstats-2m@<name>
# rusty-kaspa gRPC (--rpclisten); the DAG is sampled every POLL_INTERVAL
CHAIN=kaspa
RPC_HOST=localhost
RPC_PORT=16110
POLL_INTERVAL=1s
LISTENING_PORT=16111
WS_SERVER=wss://kas-stats.2miners.com
WS_SECRET=4ce279da264302069d919845eead5350
INSTANCE_NAME=Your Pool Kaspa
CONTACT_DETAILS=
NODE_ENV=production
VERBOSITY=1
