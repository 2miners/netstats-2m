# Bitcoin: copy to /opt/netstats-2m/<name>.env, then: systemctl enable --now netstats-2m@<name>
# bitcoind RPC: rpcuser / rpcpassword from bitcoin.conf; fees come from getblockstats
CHAIN=btc
RPC_HOST=localhost
RPC_PORT=8332
RPC_USER=
RPC_PASSWORD=
SUBSIDY_START=50
SUBSIDY_HALVING=210000
LISTENING_PORT=8333
WS_SERVER=wss://btc-stats.2miners.com
WS_SECRET=4ce279da264302069d919845eead5350
INSTANCE_NAME=Your Pool Bitcoin
CONTACT_DETAILS=
NODE_ENV=production
VERBOSITY=1
